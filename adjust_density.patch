+def run_post_convergence_check(
+    solvent_root,
+    state,
+    nvt_mdp,
+    collection_root,
+    mof_name,
+    solvent,
+):
+    """
+    fine 收敛后的 5ns 续跑 + 重新校验密度主循环。
+
+    状态机：
+        check_status == "passed"           -> 直接返回，不重跑
+        check_status == "max_retries_exceeded" -> 告警退出
+        check_status in (pending, running)  -> 从 check_round 开始继续
+
+    每轮：
+        1. 调 extend_nvt_for_check 续算 5ns
+        2. 调 run_check_density 统计新增 5ns 段密度
+        3. |ρ_check - ρ_fine| / ρ_fine > 1% -> 下一轮（基于本轮 cpt 续算）
+        4. 否则 -> check_passed，更新 density_profiles.csv 与 final_density_result.json
+        5. 最多 CHECK_MAX_RETRIES 轮
+    """
+    check_status = state.get("check_status", "pending")
+    max_retries = int(state.get("check_max_retries", CHECK_MAX_RETRIES))
+
+    if check_status == "passed":
+        print("\n" + "=" * 72)
+        print("POST-CONVERGENCE CHECK ALREADY PASSED")
+        print("=" * 72)
+        print(f"Check rounds    : {state.get('check_round', 0)}")
+        print(f"Fine density    : {state.get('fine_density')}")
+        if state.get("check_measurements"):
+            last = state["check_measurements"][-1]
+            print(f"Last check rho  : {last['density']:.6f}")
+            print(
+                f"Last change     : "
+                f"{last['relative_change'] * 100.0:.4f}%"
+            )
+        print(f"Result file     : {Path(solvent_root) / FINAL_RESULT_JSON}")
+        return
+
+    if check_status == "max_retries_exceeded":
+        warn(
+            "此前 5ns check 已达到最大重试次数仍未稳定。\n"
+            f"如需重新开始 check，请删除或编辑 "
+            f"{Path(solvent_root) / FINAL_RESULT_JSON} 与 "
+            f"{Path(solvent_root) / STATE_JSON} 中的 check_* 字段。"
+        )
+        return
+
+    # --------------------------------------------------------------
+    # 强制重新解析 fine_density / fine_directory（不信任 state 缓存）
+    # --------------------------------------------------------------
+    # 历史版本的 fine_directory 可能被错误保存为 solvent_root 或
+    # 原始 trial 目录，导致 5ns check 续算产物写到错误位置
+    # （如 ACN/first/ 而不是 ACN/fine/first/）。因此每次进入 check
+    # 流程都强制从可信来源重新解析并覆盖 state 中的值。
+    #
+    # 可信优先级：
+    #   1) final_density_result.json["snapshot_directory"]
+    #   2) <solvent_root>/fine/ 目录（copy_system_snapshot 的标准位置）
+    #   3) final_density_result.json["directory"]（原始 trial 目录，
+    #      需要 first/nvt.cpt 存在且含 snapshot 特征文件）——慎用
+    #
+    # fine_directory 最终必须满足：
+    #   - 是一个真实存在的目录
+    #   - 包含 first/nvt.cpt（原 NVT checkpoint）
+    #   - 包含 first/nvt.tpr
+    #
+    # 此外 fine_directory 的 "正常" 形式应为 <solvent_root>/fine/。
+    # 虽然 trial 目录也可能满足 first/nvt.cpt 存在，但续算产物会留在
+    # trial 目录里、不易找到，因此一旦能找到 solvent_root/fine/
+    # 就优先用它。
+    # --------------------------------------------------------------
+    re_evaluated = False
+
+    expected_fine_dir = Path(solvent_root) / FINE_SNAPSHOT_DIR
+
+    # --- fine_density ---
+    fine_density_src = None
+    if state.get("fine_density") is not None:
+        fine_density_src = "state cache"
+    final_result = {}
+    result_path = Path(solvent_root) / FINAL_RESULT_JSON
+    if result_path.is_file():
+        try:
+            final_result = json.loads(result_path.read_text(encoding="utf-8"))
+        except Exception:
+            final_result = {}
+
+    # 强制覆盖 fine_density（优先 final_result.density，不丢 state 值）
+    if state.get("fine_density") is None and final_result.get("density") is not None:
+        try:
+            state["fine_density"] = float(final_result["density"])
+            fine_density_src = "final_result:density"
+            re_evaluated = True
+        except (TypeError, ValueError):
+            pass
+    if state.get("fine_density") is None and state.get("measurements"):
+        last = state["measurements"][-1]
+        try:
+            state["fine_density"] = float(last["density"])
+            fine_density_src = "measurements[-1]:density"
+            re_evaluated = True
+        except (TypeError, ValueError, KeyError, IndexError):
+            pass
+
+    # --- fine_directory ---
+    fine_directory_src = None
+    resolved_fine_dir: Optional[Path] = None
+
+    # 1) final_density_result.json["snapshot_directory"]
+    d = final_result.get("snapshot_directory")
+    if d:
+        p = Path(d)
+        if p.is_dir() and (p / "first" / "nvt.cpt").is_file() \
+                and (p / "first" / "nvt.tpr").is_file():
+            resolved_fine_dir = p.resolve()
+            fine_directory_src = "final_result:snapshot_directory"
+
+    # 2) solvent_root/fine/ 标准快照目录（如果存在）
+    if resolved_fine_dir is None and expected_fine_dir.is_dir() \
+            and (expected_fine_dir / "first" / "nvt.cpt").is_file() \
+            and (expected_fine_dir / "first" / "nvt.tpr").is_file():
+        resolved_fine_dir = expected_fine_dir.resolve()
+        fine_directory_src = f"solvent_root/{FINE_SNAPSHOT_DIR}"
+
+    # 3) final_density_result.json["directory"]（原始 trial 目录，兜底）
+    if resolved_fine_dir is None:
+        d2 = final_result.get("directory")
+        if d2:
+            p2 = Path(d2)
+            if p2.is_dir() and (p2 / "first" / "nvt.cpt").is_file() \
+                    and (p2 / "first" / "nvt.tpr").is_file():
+                resolved_fine_dir = p2.resolve()
+                fine_directory_src = "final_result:directory"
+
+    # 4) state 中已有的 fine_directory 兜底（仅作为最后手段，但要校验）
+    if resolved_fine_dir is None and state.get("fine_directory"):
+        p3 = Path(state["fine_directory"])
+        if p3.is_dir() and (p3 / "first" / "nvt.cpt").is_file() \
+                and (p3 / "first" / "nvt.tpr").is_file():
+            resolved_fine_dir = p3.resolve()
+            fine_directory_src = "state cache"
+
+    # 最终覆盖 state["fine_directory"]：只有成功解析到才覆盖
+    if resolved_fine_dir is not None:
+        if state.get("fine_directory") != str(resolved_fine_dir):
+            re_evaluated = True
+        state["fine_directory"] = str(resolved_fine_dir)
+
+    if re_evaluated:
+        save_state(solvent_root, state)
+        print(
+            "\n[fine_dir] 已重新解析 fine_density/fine_directory"
+            "（不信任 state 缓存，强制覆盖）："
+        )
+        print(f"  fine_density    = {state.get('fine_density')}  "
+              f"(来源: {fine_density_src})")
+        print(f"  fine_directory  = {state.get('fine_directory')}  "
+              f"(来源: {fine_directory_src})")
+        # 关键防御性检查：如果 fine_directory 不是 solvent_root/fine/
+        # 但 solvent_root/fine/ 本身又存在，提示异常。
+        if resolved_fine_dir is not None \
+                and expected_fine_dir.is_dir() \
+                and resolved_fine_dir != expected_fine_dir.resolve():
+            warn(
+                f"注意：解析到的 fine_directory 不是标准路径 "
+                f"{expected_fine_dir}。\n这通常意味着你的体系是在旧版本"
+                "脚本下收敛的，fine/ 快照可能不存在或不全。\n"
+                "续算产物将写入上述解析到的目录中。"
+            )
+
+    if state.get("fine_density") is None:
+        fail(
+            "fine_density 缺失，且无法从 final_density_result.json "
+            "或 measurements 回填。请检查 "
+            f"{Path(solvent_root) / FINAL_RESULT_JSON} 与 "
+            f"{Path(solvent_root) / STATE_JSON}。"
+        )
+
+    fine_dir = Path(state["fine_directory"]) if state.get("fine_directory") else None
+    if fine_dir is None or not fine_dir.is_dir():
+        fail(
+            "fine 收敛体系目录不存在或无法从以下来源可靠解析：\n"
+            f"  1) {result_path} 的 snapshot_directory 字段\n"
+            f"  2) {expected_fine_dir} 目录（first/nvt.cpt 必须存在）\n"
+            f"  3) {result_path} 的 directory 字段\n"
+            f"  4) state.fine_directory 缓存\n\n"
+            "请确认 <solvent_root>/fine/ 目录存在，且 fine/first/nvt.cpt "
+            "与 fine/first/nvt.tpr 可访问。"
+        )
+    # 额外防御：确保 fine 目录的 first/nvt.cpt/tpr 真的存在
